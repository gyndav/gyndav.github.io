---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Blog — David Guyon">
  <nav style="margin-bottom: 2.5rem;">
    <a href="/">~/</a> <span class="muted">/</span> blog
  </nav>

  <h1>Blog</h1>

  <ul style="list-style: none; padding: 0; margin-top: 1.5rem;">
    {posts.map(post => (
      <li style="display: flex; gap: 1.5rem; align-items: baseline; margin: 0.6rem 0;">
        <span class="muted" style="font-size: 0.85rem; flex-shrink: 0;">
          {post.data.date.toISOString().slice(0, 10)}
        </span>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
