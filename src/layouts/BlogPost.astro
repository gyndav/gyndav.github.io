---
import Base from './Base.astro';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  date: Date;
  description?: string;
}
const { title, date, description } = Astro.props;
---
<Base title={title} description={description}>
  <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
    <a href="/">~/</a> <span class="muted">/</span> <a href="/blog/">blog</a>
  </nav>

  <article>
    <header style="margin-bottom: 2rem;">
      <h1>{title}</h1>
      <p class="muted" style="margin-top: 0.35rem; font-size: 0.85rem;">{formatDate(date)}</p>
    </header>
    <slot />
  </article>

  <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
    <a href="/blog/">← all posts</a>
  </footer>
</Base>
